{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed kit extension manifest",
  "description": "Internal kit contract, not a native provider plugin format. Runtime loading is pending.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "kind",
    "host_protocol",
    "capabilities",
    "implementation",
    "permissions",
    "contracts",
    "configuration",
    "conformance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "enum": [
        "agent",
        "stack",
        "storage",
        "delivery",
        "telemetry",
        "tool",
        "profile_renderer"
      ]
    },
    "host_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major"
      ],
      "properties": {
        "major": {
          "const": 1
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport"
      ],
      "properties": {
        "transport": {
          "enum": [
            "in_process",
            "command",
            "mcp",
            "http"
          ]
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "endpoint_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "transport": {
              "const": "in_process"
            }
          },
          "required": [
            "entrypoint"
          ]
        },
        {
          "properties": {
            "transport": {
              "const": "command"
            }
          },
          "required": [
            "argv"
          ]
        },
        {
          "properties": {
            "transport": {
              "enum": [
                "mcp",
                "http"
              ]
            }
          },
          "required": [
            "endpoint_ref"
          ]
        }
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem",
        "network",
        "credential_refs"
      ],
      "properties": {
        "filesystem": {
          "enum": [
            "none",
            "read_only",
            "task_workspace"
          ]
        },
        "network": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "credential_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref"
      ],
      "properties": {
        "schema_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_ref",
        "status"
      ],
      "properties": {
        "suite_ref": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        }
      }
    }
  }
}
