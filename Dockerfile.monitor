FROM python:3.12-slim@sha256:dddfd7e07f9d15aeeca61529320492139d21cac7f0070c00609243e51e4e0016
WORKDIR /app
COPY requirements-monitor.lock pyproject.toml ./
RUN python -m pip install --no-cache-dir -r requirements-monitor.lock
COPY dev_agent_kit ./dev_agent_kit
RUN python -m pip install --no-cache-dir --no-deps .
USER 1000:1000
EXPOSE 8765
CMD ["python", "-m", "dev_agent_kit", "--state-dir", "/state", "serve", "--host", "0.0.0.0"]
